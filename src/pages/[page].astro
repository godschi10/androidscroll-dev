---
import Layout from '../layouts/Layout.astro';
import { getPages, getRankMathHead, decode } from '../lib/wp';
import { serverSanitizeHtml } from '../lib/server-sanitize';

export async function getStaticPaths() {
  const pages = await getPages();
  const heads = await Promise.all(pages.map((p: any) => getRankMathHead(p.slug)));
  return pages.map((p: any, i: number) => ({
    params: { page: p.slug },
    props: { page: p, rankMathHead: heads[i] },
  }));
}

const { page, rankMathHead } = Astro.props;
if (!page) return Astro.redirect('/404');

const title = decode(page.title.rendered.replace(/<[^>]+>/g, ''));
const description = decode(page.excerpt?.rendered?.replace(/<[^>]+>/g, '').trim() ?? '');
const safeContent = serverSanitizeHtml(page.content.rendered);
---

<Layout title={title} description={description} rankMathHead={rankMathHead}>
  <article style="max-width:640px; margin:auto; background:var(--bg-surface); padding:30px var(--container-side-padding);">
    <h1 style="margin-bottom:1em;">{title}</h1>
    <div class="post-content" set:html={safeContent}></div>
  </article>
  {page.slug === 'privacy-policy' && (
    <script src="/js/matomo-opt-out.js" defer></script>
  )}
</Layout>
