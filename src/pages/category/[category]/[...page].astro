---
import Layout from '../../../layouts/Layout.astro';
import { getCategories, getPostsByCategory, decode } from '../../../lib/wp';

function wpExcerpt(p: any, words = 60): string {
  const raw = p.excerpt?.rendered || p.content?.rendered || '';
  return decode(raw.replace(/<[^>]+>/g, ' ').replace(/\s+/g, ' ').trim())
    .split(' ').slice(0, words).join(' ') + '…';
}

export async function getStaticPaths({ paginate }: { paginate: Function }) {
  const cats = await getCategories();
  const parents = cats.filter((c: any) => c.parent === 0);

  const allPaths: any[] = [];

  for (const cat of parents) {
    const posts = await getPostsByCategory(cat.id);

    const pages = paginate(posts, {
      params: { category: cat.slug },
      props: { cat },
      pageSize: 12,
    });

    allPaths.push(...pages);
  }

  return allPaths;
}

const { cat, page } = Astro.props;
const posts = page.data;
---

<Layout
  title={page.currentPage === 1 ? decode(cat.name) : `${decode(cat.name)} – Page ${page.currentPage}`}
  pageSchema={{
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "name": decode(cat.name),
    "url": `https://androidscroll.com/category/${cat.slug}`,
    "description": `Browse all ${decode(cat.name)} articles on AndroidScroll`,
    "breadcrumb": {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://androidscroll.com" },
        { "@type": "ListItem", "position": 2, "name": "Categories", "item": "https://androidscroll.com/category" },
        { "@type": "ListItem", "position": 3, "name": decode(cat.name), "item": `https://androidscroll.com/category/${cat.slug}` }
      ]
    }
  }}
>
  <nav class="as-breadcrumbs" aria-label="Breadcrumb">
    <a href="/" class="as-bc-home">Home</a>
    <span class="as-bc-sep" aria-hidden="true">›</span>
    <span class="category_meta-pill">{decode(cat.name)}</span>
  </nav>

  <h1 class="text-3xl font-bold mb-8 text-neutral-900 dark:text-neutral-100">
    {decode(cat.name)}
    {page.currentPage > 1 && <span class="text-lg font-normal text-neutral-400 ml-2">– Page {page.currentPage}</span>}
  </h1>

<style>
  .as-breadcrumbs { display:flex; flex-wrap:wrap; align-items:center; gap:6px; font-size:12px; color:var(--text-muted); margin-bottom:14px; line-height:1.4; }
  .as-bc-home { color:var(--text-muted); text-decoration:none; }
  .as-bc-home:hover { color:var(--brand-primary,#00a896); }
  .as-bc-sep { opacity:0.45; font-size:11px; }
  .category_meta-pill { display:inline-flex; align-items:center; padding:3px 10px; border-radius:999px; border:1.5px solid var(--brand-primary,#00a896); color:var(--brand-primary,#00a896); font-size:11px; font-weight:700; text-transform:uppercase; letter-spacing:0.6px; text-decoration:none; }
  a.category_meta-pill:hover { background:var(--brand-primary,#00a896); color:#fff; }

  .as-pagination { display:flex; align-items:center; justify-content:center; gap:12px; margin-top:48px; }
  .as-pagination a { display:inline-flex; align-items:center; gap:6px; padding:8px 18px; border-radius:8px; border:1.5px solid var(--brand-primary,#00a896); color:var(--brand-primary,#00a896); font-size:13px; font-weight:600; text-decoration:none; transition:background 0.2s, color 0.2s; }
  .as-pagination a:hover { background:var(--brand-primary,#00a896); color:#fff; }
  .as-pagination span { font-size:13px; color:var(--text-muted); }
</style>

  {posts.length === 0 && <p class="text-neutral-500">No posts yet.</p>}

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    {posts.map((post: any) => {
      const img = post._embedded?.['wp:featuredmedia']?.[0]?.source_url;
      const title = decode(post.title.rendered.replace(/<[^>]+>/g, ''));
      const desc = wpExcerpt(post, 60);
      return (
        <a href={`/${post.slug}/`} class="group flex flex-col rounded-xl overflow-hidden bg-surface-2 border border-neutral-200 dark:border-neutral-700 hover:border-[#00a88f] hover:shadow-md transition-all duration-300">
          {img
            ? <div class="w-full h-44 overflow-hidden"><img src={img} alt={title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" /></div>
            : <div class="w-full h-2 bg-gradient-to-r from-[#00a88f] to-[#008c72]"></div>
          }
          <div class="p-5 flex flex-col flex-1" style="background:var(--bg-surface);">
            <h2 class="font-bold text-neutral-900 dark:text-neutral-100 group-hover:text-[#00a88f] transition-colors leading-snug">{title}</h2>
            <p class="mt-1 text-xs text-neutral-400">{new Date(post.date).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}</p>
            {desc && <p class="mt-2 text-sm text-neutral-600 dark:text-neutral-300 line-clamp-2 flex-1">{desc}</p>}
          </div>
        </a>
      );
    })}
  </div>

  <nav class="as-pagination" aria-label="Pagination">
    {page.url.prev && <a href={page.url.prev}>← Previous</a>}
    <span>Page {page.currentPage} of {page.lastPage}</span>
    {page.url.next && <a href={page.url.next}>Next →</a>}
  </nav>

</Layout>
